{
  "name": "@marketplace-reviewer/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "prisma": "^6.19.3",
    "typescript": "~5.8.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.2"
  }
}
